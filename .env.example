# Copy to .env.local (never commit real values).
#
# Optional: form-service endpoint that accepts a JSON POST, e.g.
#   Formspree  -> https://formspree.io/f/<form-id>
#   Web3Forms  -> https://api.web3forms.com/submit  (also set VITE_FORM_ACCESS_KEY)
# When empty, enquiries are handed off to WhatsApp / email / Instagram instead
# (see src/config/site.ts).
VITE_FORM_ENDPOINT=
# Public access key for services that require one in the payload (Web3Forms).
# This key is designed to be public; never place private API secrets in VITE_ variables.
VITE_FORM_ACCESS_KEY=
